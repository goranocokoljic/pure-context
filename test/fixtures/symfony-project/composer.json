{
    "name": "symfony/skeleton",
    "type": "project",
    "description": "A minimal Symfony project recommendation",
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "^6.3",
        "symfony/console": "^6.3",
        "symfony/dotenv": "^6.3",
        "symfony/flex": "^2",
        "symfony/runtime": "^6.3",
        "symfony/yaml": "^6.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "symfony/test-pack": "^1.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
