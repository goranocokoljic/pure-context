{
  "name": "purecontext-mcp",
  "version": "1.11.1",
  "description": "Change-aware code intelligence for AI coding agents (MCP): blast radius, temporal co-change, and per-symbol risk before the edit — built on token-efficient code navigation",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goranocokoljic/pure-context.git"
  },
  "bugs": {
    "url": "https://github.com/goranocokoljic/pure-context/issues"
  },
  "homepage": "https://github.com/goranocokoljic/pure-context#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-navigation",
    "tree-sitter",
    "typescript",
    "ai",
    "llm",
    "claude"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "grammars/",
    "prebuilds/",
    "src/ui/dist/",
    "scripts/check-sqlite.js",
    "README.md",
    "AGENT_INSTRUCTIONS.md",
    "AGENT_REFERENCE.md",
    "AI-SUMMARIES.md",
    "AST-SEARCH.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "CODE-HEALTH.md",
    "CODE-HISTORY.md",
    "CODE-INTELLIGENCE.md",
    "FINDING-CODE.md",
    "FRAMEWORK-ADAPTERS.md",
    "FULL-INSTALLATION-GUIDE.md",
    "HEALTH-DASHBOARDS.md",
    "LANGUAGE-SUPPORT.md",
    "LICENSE",
    "NAVIGATING-NEW-CODE.md",
    "REFACTORING-SAFELY.md",
    "SAFE-CHANGES.md",
    "TEAM-SETUP.md",
    "UNDERSTANDING-RELATIONSHIPS.md",
    "USER-GUIDE.md",
    "VISUALIZING-CODE.md",
    "WEB-UI.md",
    "WHY-PURECONTEXT.md",
    "WORKFLOW-ONBOARDING.md",
    "WORKFLOW-PR-REVIEW.md",
    "WORKFLOW-REFACTORING.md",
    "WORKFLOW-TECH-DEBT.md",
    "docs/"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "purecontext-mcp": "./dist/bin.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "node scripts/generate-version.mjs && tsc",
    "build:ui": "npm --prefix src/ui run build",
    "dev": "concurrently \"tsc --watch\" \"npm --prefix src/ui run dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "benchmark": "vitest bench --run",
    "benchmark:competitive": "vitest bench --run test/benchmarks/competitive.bench.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build:prebuilds": "prebuildify --napi --strip --targets node@18 node@20 node@22",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/check-sqlite.js"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@types/js-yaml": "^4.0.9",
    "better-sqlite3": "^11.9.0",
    "chokidar": "^3.6.0",
    "hnswlib-wasm": "^0.8.2",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.1",
    "minimatch": "^9.0.9",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "gpt-tokenizer": "^2.9.0",
    "node-gyp": "^11.0.0",
    "prebuildify": "^6.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
