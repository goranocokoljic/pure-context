{
  "name": "purecontext-mcp",
  "version": "1.5.2",
  "description": "Token-efficient source code navigation MCP server for AI agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/goranocokoljic/pure-context.git"
  },
  "bugs": {
    "url": "https://github.com/goranocokoljic/pure-context/issues"
  },
  "homepage": "https://github.com/goranocokoljic/pure-context#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-navigation",
    "tree-sitter",
    "typescript",
    "ai",
    "llm",
    "claude"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist/",
    "grammars/",
    "prebuilds/",
    "src/ui/dist/",
    "scripts/check-sqlite.js",
    "README.md",
    "AGENT_INSTRUCTIONS.md",
    "AGENT_INSTRUCTIONS_SHORT.md",
    "AGENT_REFERENCE.md",
    "AI-SUMMARIES.md",
    "AST-SEARCH.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "CODE-HEALTH.md",
    "CODE-HISTORY.md",
    "CODE-INTELLIGENCE.md",
    "FINDING-CODE.md",
    "FRAMEWORK-ADAPTERS.md",
    "FULL-INSTALLATION-GUIDE.md",
    "HEALTH-DASHBOARDS.md",
    "LANGUAGE-SUPPORT.md",
    "LICENSE",
    "NAVIGATING-NEW-CODE.md",
    "REFACTORING-SAFELY.md",
    "SAFE-CHANGES.md",
    "TEAM-SETUP.md",
    "UNDERSTANDING-RELATIONSHIPS.md",
    "USER-GUIDE.md",
    "VISUALIZING-CODE.md",
    "WEB-UI.md",
    "WHY-PURECONTEXT.md",
    "WORKFLOW-ONBOARDING.md",
    "WORKFLOW-PR-REVIEW.md",
    "WORKFLOW-REFACTORING.md",
    "WORKFLOW-TECH-DEBT.md",
    "docs/"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "purecontext-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "npm run build:server && npm run build:ui",
    "build:server": "node scripts/generate-version.mjs && tsc",
    "build:ui": "npm --prefix src/ui run build",
    "dev": "concurrently \"tsc --watch\" \"npm --prefix src/ui run dev\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "benchmark": "vitest bench --run",
    "benchmark:competitive": "vitest bench --run test/benchmarks/competitive.bench.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "build:prebuilds": "prebuildify --napi --strip --targets node@18 node@20 node@22",
    "prepublishOnly": "npm run build && npm test",
    "postinstall": "node scripts/check-sqlite.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/js-yaml": "^4.0.9",
    "better-sqlite3": "^11.9.0",
    "chokidar": "^3.6.0",
    "hnswlib-wasm": "^0.8.2",
    "ignore": "^7.0.5",
    "js-yaml": "^4.1.1",
    "minimatch": "^9.0.9",
    "tree-sitter-c": "^0.23.2",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-go": "^0.23.4",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-python": "^0.23.6",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-swift": "^0.7.1",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.22.6",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@davisvaughan/tree-sitter-r": "^1.2.0",
    "@playwright/test": "^1.59.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.19.39",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "concurrently": "^9.0.0",
    "eslint": "^8.57.0",
    "gpt-tokenizer": "^2.9.0",
    "node-gyp": "^11.0.0",
    "prebuildify": "^6.0.1",
    "tree-sitter-bash": "^0.23.3",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-lua": "^2.0.0",
    "tree-sitter-perl": "^1.0.0",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-scala": "^0.24.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
